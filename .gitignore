# Build artifacts
build/
out/
.gradle/
target/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store
Thumbs.db

# Secrets
.env
.env.local

# Python (for scripts/)
__pycache__/
*.pyc
.venv/

# Frontend
node_modules/
# Nx build output — scoped to frontend/dist/ so it does NOT match a
# frontend module named `dist` (e.g. libs/dist/, a source library).
frontend/dist/
# ng-packagr output for individual libs (frontend/dist/ above only matches the
# workspace-root dist/, not the per-lib dist/ nested under libs/*).
frontend/libs/*/*/dist/
frontend/libs/*/dist/

# Nx/Angular local caches and test coverage reports — regenerated on every run.
frontend/.angular/
frontend/coverage/

# Compiled output of the NestJS services. Scoped per service (not a bare `dist/`)
# for the same reason as frontend/dist/ above: a bare pattern would also swallow
# a source directory that happens to be named dist.
backend/services/*/dist/
backend/services/*/*.tsbuildinfo

# Generated Prisma Client — each service outputs to its own src/infrastructure/
# tree (per-service `output` in schema.prisma) instead of the shared workspace
# node_modules slot, so concurrent services no longer collide over the same
# physical query-engine binary. Regenerated by `prisma generate` (postinstall).
backend/services/*/src/infrastructure/prisma-client/

# IMP BDD large test fixture (> 50 MiB; generated by pnpm seed:imp-fixtures)
backend/services/imp-service/test/fixtures/livro-51mb.docx

# Playwright run output
playwright-report/
test-results/
.nx/

# Autopilot checkpoints (ephemeral runtime state — F-CKPT, D-326)
tmp/architecture-autopilot/
tmp/be-architecture-autopilot/
tmp/fe-architecture-autopilot/
tmp/be-autopilot/
tmp/fe-autopilot/
tmp/pipeline-cycle/

# Ad-hoc gate/build/lint/test run output dumped into tmp/, the repo root, or
# frontend/ by manual pipeline invocations — regenerated on every run, never
# meant to be reviewed from git history. Scoped with a leading slash / explicit
# dirs so this does NOT swallow *.log files that are actually meant to be
# tracked source elsewhere in the tree.
/*.log
tmp/*.log
tmp/*.json
tmp/*.txt
tmp/backend-logs/
frontend/tmp/
frontend/*.log
backend/services/*/lint-output.txt
backend/services/*/test-output.log
backend/services/*/test-e2e-output.log
backend/services/*/README.md.scaffold
tmp/*.py

# Ephemeral runtime/observability state — trace context (F2, D-423),
# runtime learning signals + token-usage JSONL (techlab-runtime).
# Surgical: other .techlab/ artifacts (e.g. assembly-*.json) stay tracked.
.techlab/trace-context.json
.techlab/learning/
.techlab/token-usage/
