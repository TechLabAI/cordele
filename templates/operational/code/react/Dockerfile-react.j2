{#-
  Dockerfile-react.j2 — multi-stage image for the Next.js 15 frontend (D-546).

  Stages: deps (lockfile-only install, cacheable) -> builder (next build) ->
  runtime (copies `.next/standalone` produced by `output: 'standalone'`).
  Runs as the non-root `nextjs` user.

  Variables: project_name, node_version, package_manager.
-#}
{%- set pm = package_manager | default('pnpm', true) -%}
{%- set node = node_version | default('22', true) -%}
# syntax=docker/dockerfile:1

# ── deps ──────────────────────────────────────────────────────────────────────
FROM node:{{ node }}-alpine AS deps
WORKDIR /app
{%- if pm == 'pnpm' %}
RUN corepack enable && corepack prepare pnpm@latest --activate
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile
{%- elif pm == 'yarn' %}
RUN corepack enable
COPY package.json yarn.lock* ./
RUN yarn install --frozen-lockfile
{%- else %}
COPY package.json package-lock.json* ./
RUN npm ci
{%- endif %}

# ── builder ───────────────────────────────────────────────────────────────────
FROM node:{{ node }}-alpine AS builder
WORKDIR /app
{%- if pm == 'pnpm' %}
RUN corepack enable && corepack prepare pnpm@latest --activate
{%- elif pm == 'yarn' %}
RUN corepack enable
{%- endif %}
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
# `public/` is optional in a fresh App Router app; the runtime stage copies it
# unconditionally, so make sure it exists.
RUN mkdir -p public
{%- if pm == 'pnpm' %}
RUN pnpm build
{%- elif pm == 'yarn' %}
RUN yarn build
{%- else %}
RUN npm run build
{%- endif %}

# ── runtime ───────────────────────────────────────────────────────────────────
FROM node:{{ node }}-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
 && adduser --system --uid 1001 nextjs

# `output: 'standalone'` ships its own minimal node_modules inside .next/standalone.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs
EXPOSE 3000
LABEL org.opencontainers.image.title="{{ project_name }}-frontend"

CMD ["node", "server.js"]
