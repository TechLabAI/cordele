{#-
  react/e2e/fixtures/auth.fixture.ts.j2 - authenticated page fixture.

  Rendered by: /new-project P5 (_frontend_react) →
    frontend/e2e/fixtures/auth.fixture.ts

  Variables used:
    - project_name
    - multi_tenancy_mode, multi_tenancy_term

  The session is seeded straight into sessionStorage with an init script (same
  key the AuthProvider reads), so specs never pay for a UI login round-trip.
  `test.use({ realLogin: true })` opts a spec into the actual form instead.
-#}
import { test as base, expect, type Page } from '@playwright/test';

/** Must match SESSION_STORAGE_KEY in lib/shared/auth/auth-context.tsx. */
export const SESSION_STORAGE_KEY = '{{ project_name }}.session';

export interface TestSession {
  user: {
    id: string;
    name: string;
    email: string;
    roles: string[];
{%- if multi_tenancy_mode != 'single' %}
    tenant: string;
{%- endif %}
  };
  accessToken: string;
}

export const DEFAULT_SESSION: TestSession = {
  user: {
    id: '00000000-0000-0000-0000-000000000001',
    name: 'E2E User',
    email: 'e2e@{{ project_name }}.test',
    roles: ['admin'],
{%- if multi_tenancy_mode != 'single' %}
    // Default {{ multi_tenancy_term }} used by the seeded fixtures.
    tenant: 'e2e',
{%- endif %}
  },
  accessToken: 'e2e-access-token',
};

export async function seedSession(page: Page, session: TestSession = DEFAULT_SESSION) {
  await page.addInitScript(
    ([key, value]) => {
      window.sessionStorage.setItem(key, value);
    },
    [SESSION_STORAGE_KEY, JSON.stringify(session)] as const,
  );
}

export async function login(page: Page, email: string, password: string{% if multi_tenancy_mode != 'single' %}, tenant: string{% endif %}) {
  await page.goto('/login');
  await page.getByLabel('E-mail').fill(email);
  await page.getByLabel('Password').fill(password);
{%- if multi_tenancy_mode != 'single' %}
  await page.getByLabel('{{ multi_tenancy_term | capitalize }}').fill(tenant);
{%- endif %}
  await page.getByRole('button', { name: 'Sign in' }).click();
  await page.waitForURL((url) => !url.pathname.startsWith('/login'));
}

interface AuthFixtures {
  /** Set to true in a spec that exercises the login form itself. */
  realLogin: boolean;
  session: TestSession;
}

export const test = base.extend<AuthFixtures>({
  realLogin: [false, { option: true }],
  session: [DEFAULT_SESSION, { option: true }],

  page: async ({ page, realLogin, session }, use) => {
    if (!realLogin) {
      await seedSession(page, session);
    }
    await use(page);
  },
});

export { expect };
