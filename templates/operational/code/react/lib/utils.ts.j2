{#-
  utils.ts.j2 - the cn() helper every shadcn/ui component expects (D-548).

  Rendered to src/lib/utils.ts. Imported as '@/lib/utils' by the shell, the
  shared UI primitives and every shadcn component added via the CLI.
-#}
import { clsx, type ClassValue } from 'clsx';
import { twMerge } from 'tailwind-merge';

/**
 * Merge Tailwind class names, letting later classes win.
 *
 * clsx resolves conditionals; twMerge then drops earlier classes that the
 * later ones override, so `cn('p-2', 'p-4')` yields `p-4` instead of both.
 */
export function cn(...inputs: ClassValue[]): string {
  return twMerge(clsx(inputs));
}
