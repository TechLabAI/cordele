{#-
  global-exception-handler.java.j2 — RestControllerAdvice driving ProblemDetail.

  Variables: pkg_full

  D-069 (Tier 2.1 Phase 2 — error-model): catches CodedException and dispatches
  to ProblemDetailFactory which uses the baked catalogue. Generic Exception
  fallback still maps to internal_error/500.
-#}
package {{ pkg_full }}.api.exception;

import {{ pkg_full }}.shared.error.CodedException;
import {{ pkg_full }}.shared.error.ProblemDetailFactory;

import jakarta.servlet.http.HttpServletRequest;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.ProblemDetail;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;
import org.springframework.web.servlet.mvc.method.annotation.ResponseEntityExceptionHandler;

@Slf4j
@RestControllerAdvice
public class GlobalExceptionHandler extends ResponseEntityExceptionHandler {

    /**
     * Coded exceptions thrown by application/domain services. Resolved against
     * the error-model.arch.json catalogue via ProblemDetailFactory (D-069).
     */
    @ExceptionHandler(CodedException.class)
    public ProblemDetail handleCoded(CodedException ex, HttpServletRequest req) {
        log.warn("Coded exception code={} message={}", ex.code(), ex.getMessage());
        return ProblemDetailFactory.forCode(ex.code(), ex, req, ex.context());
    }

    /**
     * Unhandled exceptions — map to the internal_error category (HTTP 500)
     * via the factory so the response payload still conforms to the
     * documented schema.
     */
    @ExceptionHandler(Exception.class)
    public ProblemDetail handleGenericException(Exception ex, HttpServletRequest req) {
        log.error("Unhandled exception", ex);
        return ProblemDetailFactory.forCode(null, ex, req);
    }
}
