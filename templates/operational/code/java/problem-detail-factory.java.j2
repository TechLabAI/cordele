package {{ pkg_full }}.shared.error;

import jakarta.servlet.http.HttpServletRequest;
import org.slf4j.MDC;
import org.springframework.http.HttpStatus;
import org.springframework.http.ProblemDetail;

import java.net.URI;
import java.time.OffsetDateTime;
import java.util.Map;
import java.util.Objects;

/**
 * RFC-{{ media_type | default("7807") }} ProblemDetail builder driven by the baked error catalogue
 * (error-model.arch.json, D-064). Maps a code to category + HTTP status +
 * default title, then populates the standard ProblemDetail fields plus the
 * extension fields declared in the catalogue (code, category, correlationId,
 * timestamp, context).
 *
 * <p>Generated by be-module-generator (D-069). Regenerate when the catalogue
 * version bumps.
 */
public final class ProblemDetailFactory {

    private record ErrorMetadata(String category, int httpStatus, String title) {}
    private record CategoryMetadata(int defaultStatus, String feActionHint) {}

    private static final String MEDIA_TYPE = "{{ media_type }}";
    private static final String TYPE_URI_TEMPLATE = "{{ type_uri_template }}";

    private static final Map<String, ErrorMetadata> CODE_METADATA = Map.ofEntries(
{%- for e in flat_codes %}
        Map.entry("{{ e.code }}",
            new ErrorMetadata("{{ e.category }}", {{ e.http_status }},
                "{{ (e.title or e.code) | replace('"', '\\"') }}")){{ "," if not loop.last }}
{%- endfor %}
{%- if not flat_codes %}
        // (no error-model.arch.json pinned at generation time)
{%- endif %}
    );

    private static final Map<String, CategoryMetadata> CATEGORY_METADATA = Map.ofEntries(
{%- for c in categories %}
        Map.entry("{{ c.id }}",
            new CategoryMetadata({{ c.default_http_status }}, "{{ c.fe_action_hint or '' }}")){{ "," if not loop.last }}
{%- endfor %}
{%- if not categories %}
        // (no error-model.arch.json pinned at generation time)
{%- endif %}
    );

    private static final ErrorMetadata INTERNAL_FALLBACK =
        new ErrorMetadata("internal_error", 500, "Internal Server Error");

    private ProblemDetailFactory() {
    }

    /**
     * Build a ProblemDetail for the given error code. Unknown codes are
     * mapped to the internal_error fallback so the response is still a
     * valid ProblemDetail; the unknown code is logged in `error.code` for
     * the FE to surface (or for ops to investigate as a missing entry).
     */
    public static ProblemDetail forCode(String code,
                                        Throwable ex,
                                        HttpServletRequest req,
                                        Map<String, Object> context) {
        ErrorMetadata meta = code == null ? INTERNAL_FALLBACK
            : CODE_METADATA.getOrDefault(code, INTERNAL_FALLBACK);
        ProblemDetail pd = ProblemDetail.forStatus(HttpStatus.valueOf(meta.httpStatus()));
        pd.setTitle(meta.title());
        pd.setDetail(ex != null && ex.getMessage() != null && !ex.getMessage().equals(code)
            ? ex.getMessage() : meta.title());
        pd.setType(URI.create(TYPE_URI_TEMPLATE.replace("{code}", code == null ? "internal_error" : code)));
        if (req != null) {
            pd.setInstance(URI.create(req.getRequestURI()));
        }
        // Extension fields under top-level keys (Spring ProblemDetail flattens
        // them via setProperty; FE convention groups them under "error").
        pd.setProperty("error", Map.of(
            "code", code == null ? "internal_error.unhandled" : code,
            "category", meta.category(),
            "correlationId", Objects.requireNonNullElse(MDC.get("correlationId"), ""),
            "timestamp", OffsetDateTime.now().toString(),
            "context", context == null ? Map.of() : context
        ));
        return pd;
    }

    public static ProblemDetail forCode(String code, Throwable ex, HttpServletRequest req) {
        return forCode(code, ex, req, Map.of());
    }

    /** Convenience for tests / programmatic use. */
    public static String mediaType() {
        return MEDIA_TYPE;
    }
}
