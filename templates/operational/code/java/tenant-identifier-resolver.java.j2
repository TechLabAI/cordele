package {{ pkg_full }}.infrastructure.security;

import org.hibernate.context.spi.CurrentTenantIdentifierResolver;
import org.springframework.stereotype.Component;

/**
 * Tells Hibernate which tenant identifier to use for the current Session.
 * Pairs with {@link MultiTenantConnectionProvider} to realise
 * schema-per-tenant (multi-tenancy.arch.json, D-063). Generated by D-071.
 */
@Component
public class TenantIdentifierResolver implements CurrentTenantIdentifierResolver<String> {

    private static final String GLOBAL_FALLBACK = "{{ tenant_global_schema }}";

    @Override
    public String resolveCurrentTenantIdentifier() {
        String tenant = TenantContextHolder.getTenantIdOrNull();
        return tenant == null || tenant.isBlank() ? GLOBAL_FALLBACK : tenant;
    }

    @Override
    public boolean validateExistingCurrentSessions() {
        // Re-validate the tenant identifier on every Session reuse so a
        // stale ThreadLocal can't leak across pooled threads.
        return true;
    }
}
