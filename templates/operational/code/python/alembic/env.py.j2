{#-
  env.py.j2 - async Alembic migration environment (D-542, D-543).

  Renders to:
    src/<package_name>/infrastructure/persistence/alembic/env.py

  Multi-tenancy (D-543): when the project is tenanted, one migration pass runs
  per schema with `search_path` pinned and the Alembic version table stored
  inside that schema, so tenants stay independently versioned. A single pass is
  used otherwise.

  Variables: package_name, project_name, multi_tenancy_mode,
             tenant_global_schema, tenant_schemas
-#}
"""Alembic migration environment for {{ project_name }} (async, D-543).

The database URL is never read from alembic.ini: it comes from the
DATABASE_URL environment variable, the same value pydantic-settings binds
into the application Settings object.
"""
from __future__ import annotations

import asyncio
import os
from logging.config import fileConfig

from alembic import context
from sqlalchemy import pool, text
from sqlalchemy.engine import Connection
from sqlalchemy.ext.asyncio import async_engine_from_config

# The DeclarativeBase lives in the persistence models package -- py-module-generator
# renders model.py.j2 to infrastructure/persistence/models/__init__.py, so the
# importable path is <package>.<module>.infrastructure.persistence.models.
# The fallback keeps `alembic revision` usable before the persistence layer has
# been scaffolded.
try:
    from {{ package_name }}.{{ module_id }}.infrastructure.persistence.models import Base

    target_metadata = Base.metadata
except ImportError:  # pragma: no cover - bootstrap only
    target_metadata = None

config = context.config
if config.config_file_name is not None:
    fileConfig(config.config_file_name)

DEFAULT_DATABASE_URL = "postgresql+asyncpg://postgres:postgres@localhost:5432/{{ package_name }}"
{% set _tenanted = multi_tenancy_mode in ("multi-tenant", "multi-empresa") -%}
{%- if _tenanted %}
# Multi-tenancy mode: {{ multi_tenancy_mode }} - schema-per-tenant (D-543).
GLOBAL_SCHEMA = "{{ tenant_global_schema | default('public', true) }}"
TENANT_SCHEMAS: list[str] = [
{%- for schema in tenant_schemas | default([], true) %}
    "{{ schema }}",
{%- endfor %}
]
{%- else %}
# Multi-tenancy mode: {{ multi_tenancy_mode | default('single', true) }} - single schema.
GLOBAL_SCHEMA = "{{ tenant_global_schema | default('public', true) }}"
TENANT_SCHEMAS: list[str] = []
{%- endif %}

def database_url() -> str:
    """Async SQLAlchemy URL, normalized to the asyncpg driver (D-542)."""
    url = os.environ.get("DATABASE_URL") or config.get_main_option(
        "sqlalchemy.url"
    ) or DEFAULT_DATABASE_URL
    if url.startswith("postgresql://"):
        url = url.replace("postgresql://", "postgresql+asyncpg://", 1)
    return url

def target_schemas() -> list[str]:
    """Schemas to migrate, in order.

    `alembic -x schema=<name>` restricts the run to one schema, which is what
    the tenant-provisioning job uses when a new tenant is created.
    """
    override = context.get_x_argument(as_dictionary=True).get("schema")
    if override:
        return [override]
    schemas = [GLOBAL_SCHEMA]
    schemas.extend(s for s in TENANT_SCHEMAS if s != GLOBAL_SCHEMA)
    return schemas

def run_migrations_offline() -> None:
    """Emit SQL to stdout without a DBAPI connection (`alembic upgrade --sql`)."""
    url = database_url()
    for schema in target_schemas():
        context.configure(
            url=url,
            target_metadata=target_metadata,
            literal_binds=True,
            dialect_opts={"paramstyle": "named"},
            include_schemas=True,
            version_table_schema=schema,
            compare_type=True,
            compare_server_default=True,
        )
        with context.begin_transaction():
            context.execute(f'SET search_path TO "{schema}", public')
            context.run_migrations()

def do_run_migrations(connection: Connection, schema: str) -> None:
    """Run every pending revision against a single schema."""
    connection.execute(text(f'CREATE SCHEMA IF NOT EXISTS "{schema}"'))
    connection.execute(text(f'SET search_path TO "{schema}", public'))
    context.configure(
        connection=connection,
        target_metadata=target_metadata,
        include_schemas=True,
        version_table_schema=schema,
        compare_type=True,
        compare_server_default=True,
    )
    with context.begin_transaction():
        context.run_migrations()

async def run_migrations_online() -> None:
    """Open one async engine and migrate every target schema through it."""
    section = config.get_section(config.config_ini_section) or {}
    section["sqlalchemy.url"] = database_url()
    engine = async_engine_from_config(
        section,
        prefix="sqlalchemy.",
        poolclass=pool.NullPool,
    )
    try:
        for schema in target_schemas():
            async with engine.connect() as connection:
                await connection.run_sync(do_run_migrations, schema)
                await connection.commit()
    finally:
        await engine.dispose()

if context.is_offline_mode():
    run_migrations_offline()
else:
    asyncio.run(run_migrations_online())
