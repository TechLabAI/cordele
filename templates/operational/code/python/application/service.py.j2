"""Application service of the {{ module_name }} module.

Orchestration only: transaction boundary, port wiring, event emission. Business
rules live in `domain/`; this class must stay thin.
"""

from __future__ import annotations

import logging
from uuid import UUID

from fastapi import Depends
from sqlalchemy.ext.asyncio import AsyncSession

from {{ package_name }}.{{ module_id }}.fastapi.dependencies import get_db
from {{ package_name }}.{{ module_id }}.application.ports.in_ import Manage{{ ModuleId }}UseCase
{%- if has_msg_broker %}
from {{ package_name }}.{{ module_id }}.application.ports.out_ import (
    {{ ModuleId }}EventPort,
    {{ ModuleId }}Repository,
)
{%- else %}
from {{ package_name }}.{{ module_id }}.application.ports.out_ import {{ ModuleId }}Repository
{%- endif %}
from {{ package_name }}.{{ module_id }}.domain.model import Create{{ ModuleId }}Command, {{ ModuleId }}
from {{ package_name }}.{{ module_id }}.domain.service import {{ ModuleId }}DomainService

logger = logging.getLogger(__name__)


class {{ ModuleId }}ApplicationService(Manage{{ ModuleId }}UseCase):
    """Concrete implementation of the {{ module_name }} inbound port."""

    def __init__(
        self,
        repository: {{ ModuleId }}Repository,
{%- if has_msg_broker %}
        events: {{ ModuleId }}EventPort | None = None,
{%- endif %}
{%- if multi_tenancy_mode != "single" %}
        {{ multi_tenancy_term }}_id: str = "default",
{%- endif %}
    ) -> None:
        self._repository = repository
{%- if has_msg_broker %}
        self._events = events
{%- endif %}
{%- if multi_tenancy_mode != "single" %}
        self._{{ multi_tenancy_term }}_id = {{ multi_tenancy_term }}_id
{%- endif %}
        self._domain = {{ ModuleId }}DomainService(lookup=repository)

    async def create(self, command: Create{{ ModuleId }}Command) -> {{ ModuleId }}:
        aggregate = await self._domain.create(
            command,
{%- if multi_tenancy_mode != "single" %}
            {{ multi_tenancy_term }}_id=self._{{ multi_tenancy_term }}_id,
{%- endif %}
        )
        saved = await self._repository.save(aggregate)
        await self._emit("{{ module_id }}.created", saved)
        return saved

    async def get(self, item_id: UUID) -> {{ ModuleId }}:
        return await self._domain.require(item_id)

    async def list(self, page: int = 0, size: int = 20) -> tuple[list[{{ ModuleId }}], int]:
        return await self._repository.find_page(page=page, size=size)

    async def rename(self, item_id: UUID, new_name: str) -> {{ ModuleId }}:
        aggregate = await self._domain.rename(item_id, new_name)
        saved = await self._repository.save(aggregate)
        await self._emit("{{ module_id }}.renamed", saved)
        return saved

    async def delete(self, item_id: UUID) -> None:
        await self._domain.require(item_id)
        await self._repository.delete(item_id)

    async def _emit(self, routing_key: str, aggregate: {{ ModuleId }}) -> None:
        """Publish a domain event; delivery failures never break the use case."""
{%- if has_msg_broker %}
        if self._events is None:
            return
        try:
            await self._events.publish(
                routing_key,
                {
                    "id": str(aggregate.id),
{%- if multi_tenancy_mode != "single" %}
                    "{{ multi_tenancy_term }}Id": aggregate.{{ multi_tenancy_term }}_id,
{%- endif %}
                    "name": aggregate.name,
                },
            )
        except Exception:
            logger.warning("failed to publish %s to {{ msg_broker_name }}", routing_key)
{%- else %}
        # TODO[SCAFFOLD]: no message broker configured for this project; wire an outbound
        # notification adapter here when one is introduced.
        logger.debug("event %s for %s (no broker configured)", routing_key, aggregate.id)
{%- endif %}


def build_{{ module_id }}_service(
    session: AsyncSession = Depends(get_db),
) -> {{ ModuleId }}ApplicationService:
    """FastAPI provider -- overridden in tests with an in-memory repository.

    The repository adapter is imported lazily so the application layer keeps no
    import-time dependency on `infrastructure/`.
    """
    from {{ package_name }}.{{ module_id }}.infrastructure.persistence.repositories import (
        SqlAlchemy{{ ModuleId }}Repository,
    )

    return {{ ModuleId }}ApplicationService(repository=SqlAlchemy{{ ModuleId }}Repository(session))
