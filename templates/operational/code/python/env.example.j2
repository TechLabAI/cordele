# {{ backend_service }} — local environment (D-541..D-543)
#
# Copy to `.env` and fill in the secrets. `.env` is git-ignored; this file is not.
# Every key here maps 1:1 to a field of Settings in
# src/{{ package_name }}/{{ module_id }}/settings.py (pydantic-settings).

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME={{ backend_service }}
APP_ENV=local
LOG_LEVEL=INFO
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# ── Database — SQLAlchemy 2.x async (D-542) ───────────────────────────────────
# Driver must be the async one: postgresql+asyncpg, not postgresql.
DATABASE_URL={{ 'postgresql+asyncpg' if db_engine == 'postgresql' else db_engine }}://{{ project_name }}:{{ project_name }}@localhost:5432/{{ project_name }}
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
{%- if multi_tenancy_mode != "single" %}
# Multi-tenant ({{ multi_tenancy_mode }}): schema resolved per request and applied
# via search_path — see infrastructure/persistence/session.py.
TENANT_HEADER=X-Tenant-Id
TENANT_DEFAULT_SCHEMA={{ tenant_global_schema }}
{%- endif %}

# ── Migrations — Alembic (D-543) ──────────────────────────────────────────────
# Alembic reads DATABASE_URL; keep a sync URL only if you run offline migrations.
ALEMBIC_CONFIG=alembic.ini

{%- if has_msg_broker %}

# ── Messaging — {{ msg_broker_name }} ─────────────────────────────────────────
AMQP_URL=amqp://guest:guest@localhost:5672/
AMQP_EXCHANGE={{ project_name }}.events
AMQP_QUEUE={{ project_name }}.{{ module_id }}
AMQP_DLQ={{ project_name }}.{{ module_id }}.dlq
AMQP_PREFETCH=10
{%- endif %}

# ── Security ──────────────────────────────────────────────────────────────────
# Never commit a real secret. Local only.
JWT_SECRET=change-me-local-only
JWT_ALGORITHM=HS256
JWT_AUDIENCE={{ project_name }}
{%- if has_ai %}

# ── TechLab AI ────────────────────────────────────────────────────────────────
TECHLAB_AI_URL=http://localhost:8090
TECHLAB_AI_TIMEOUT_SECONDS=30
{%- endif %}
