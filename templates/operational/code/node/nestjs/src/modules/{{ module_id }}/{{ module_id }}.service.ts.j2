{#-
  {{ module_id }}.service.ts.j2 — application service (D-544).

  Variables: module_id, ModuleId, MODULE_ID, module_name,
             multi_tenancy_mode, multi_tenancy_term, has_msg_broker
-#}
import { Inject, Injectable, Logger, NotFoundException } from '@nestjs/common';

import { {{ ModuleId }}Entity } from '../../domain/{{ module_id }}.entity';
import { {{ ModuleId }}DomainService } from '../../domain/{{ module_id }}.domain-service';
import {
  {{ ModuleId }}RepositoryPort,
  type {{ ModuleId }}Page,
  type PageRequest,
} from '../../domain/{{ module_id }}.repository.interface';
{%- if has_msg_broker %}
import { {{ ModuleId }}Producer } from '../../infrastructure/messaging/{{ module_id }}.producer';
{%- endif %}
import { type AuthenticatedUser } from '../../infrastructure/auth/jwt-auth.guard';
import { Create{{ ModuleId }}Dto } from './dto/create-{{ module_id }}.dto';
import { Update{{ ModuleId }}Dto } from './dto/update-{{ module_id }}.dto';

/**
 * Application service for {{ MODULE_ID }} ({{ module_name }}).
 *
 * Orchestrates use cases: it loads aggregates through the repository port,
 * asks the domain service to decide, persists the outcome and publishes the
 * resulting integration events. It depends on ports only — never on Prisma.
 */
@Injectable()
export class {{ ModuleId }}Service {
  private readonly logger = new Logger({{ ModuleId }}Service.name);

  constructor(
    @Inject({{ ModuleId }}RepositoryPort)
    private readonly repository: {{ ModuleId }}RepositoryPort,
    private readonly domainService: {{ ModuleId }}DomainService,
{%- if has_msg_broker %}
    private readonly producer: {{ ModuleId }}Producer,
{%- endif %}
  ) {}

  async create(dto: Create{{ ModuleId }}Dto, user: AuthenticatedUser): Promise<{{ ModuleId }}Entity> {
    const entity = this.domainService.createFrom({
      name: dto.name,
      description: dto.description,
      status: dto.status,
{%- if multi_tenancy_mode and multi_tenancy_mode != 'none' %}
      tenantId: user.tenantId,
{%- endif %}
    });

    const saved = await this.repository.save(entity{% if multi_tenancy_mode and multi_tenancy_mode != 'none' %}, user.tenantId{% endif %});
    this.logger.log(`{{ MODULE_ID }} created: ${saved.id}`);
{%- if has_msg_broker %}
    await this.producer.publishCreated(saved);
{%- endif %}
    return saved;
  }

  async findAll(user: AuthenticatedUser, page: PageRequest): Promise<{{ ModuleId }}Page> {
    return this.repository.findAll(page{% if multi_tenancy_mode and multi_tenancy_mode != 'none' %}, user.tenantId{% endif %});
  }

  async findOne(id: string, user: AuthenticatedUser): Promise<{{ ModuleId }}Entity> {
    const found = await this.repository.findById(id{% if multi_tenancy_mode and multi_tenancy_mode != 'none' %}, user.tenantId{% endif %});
    if (!found) {
      throw new NotFoundException(`{{ MODULE_ID }} ${id} not found`);
    }
    return found;
  }

  async update(
    id: string,
    dto: Update{{ ModuleId }}Dto,
    user: AuthenticatedUser,
  ): Promise<{{ ModuleId }}Entity> {
    const current = await this.findOne(id, user);
    const next = this.domainService.applyChanges(current, dto);
    const saved = await this.repository.save(next{% if multi_tenancy_mode and multi_tenancy_mode != 'none' %}, user.tenantId{% endif %});
{%- if has_msg_broker %}
    await this.producer.publishUpdated(saved);
{%- endif %}
    return saved;
  }

  async remove(id: string, user: AuthenticatedUser): Promise<void> {
    await this.findOne(id, user);
    await this.repository.deleteById(id{% if multi_tenancy_mode and multi_tenancy_mode != 'none' %}, user.tenantId{% endif %});
    this.logger.log(`{{ MODULE_ID }} deleted: ${id}`);
{%- if has_msg_broker %}
    await this.producer.publishDeleted(id);
{%- endif %}
  }
}
