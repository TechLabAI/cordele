{#-
  build-cucumber-bdd-patch.gradle.kts.j2 -- opt-in Cucumber dependency block.

  Standalone patch for services that were *not* generated by
  be-module-generator.py (which already injects bdd_block). Use it when
  retrofitting Cucumber 7.x + JUnit Platform Engine into an existing
  service that started without BDD.

  Variables:
    - cucumber_version: defaults to "7.18.0" (aligned with be-module-generator.py)

  Decision: D-215 (Pole Position v3 S10) -- stack alignment.
-#}
{%- set cucumber_version = cucumber_version | default("7.18.0") -%}
// be-spec-to-bdd build patch (D-215) -- paste inside `dependencies { ... }`
// of the service build.gradle.kts. Aligned with be-module-generator.py
// bdd_block (same pin).
    // BDD -- Cucumber {{ cucumber_version }}
    testImplementation("io.cucumber:cucumber-junit-platform-engine:{{ cucumber_version }}")
    testImplementation("io.cucumber:cucumber-java:{{ cucumber_version }}")
    testImplementation("io.cucumber:cucumber-spring:{{ cucumber_version }}")
    testImplementation("org.junit.platform:junit-platform-suite-api:1.10.3")
    testImplementation("org.junit.platform:junit-platform-suite-engine:1.10.3")

// Recommended task to scope BDD runs from the service module:
//   ./gradlew :services:<service>:test --tests "*CucumberIT*"
// CucumberIT is the runner emitted by be-bdd-generator.py; pair it with the
// step stubs produced by be-spec-to-bdd.py.
