{#-
  github-actions-node.yml.j2 — CI for the Node/NestJS backend (D-544, D-545).

  Rendered to .github/workflows/backend-node-ci.yml. One matrix leg per Node
  service, so a failing module names itself in the job list. Every step runs
  from backend/ — the pnpm workspace root emitted by
  scripts/new-project.py::_backend_node.

  GitHub expressions (`${{ ... }}`) collide with Jinja delimiters and are
  therefore wrapped in `{% raw %}` blocks. Everything inside a raw block is
  emitted verbatim; do not "fix" it into a Jinja expression.

  Variables: project_name, node_version, has_msg_broker, modules
             (list of dicts with `prefix`, `name`, `backendService`).
-#}
{%- set node = node_version | default('22', true) -%}
{%- set db = project_name | replace('-', '_') -%}
{%- set svcs = (modules | default([], true)) | map(attribute='backendService') | select | list -%}
name: backend-node-ci

on:
  push:
    branches: [main, develop]
    paths:
      - 'backend/**'
      - '.github/workflows/backend-node-ci.yml'
  pull_request:
    paths:
      - 'backend/**'
      - '.github/workflows/backend-node-ci.yml'
  workflow_dispatch:

concurrency:
  group: backend-node-ci-{% raw %}${{ github.ref }}{% endraw %}
  cancel-in-progress: true

permissions:
  contents: read
  packages: write

env:
  NODE_VERSION: '{{ node }}'
  PNPM_VERSION: '9.15.4'
  REGISTRY: ghcr.io
  IMAGE_PREFIX: {{ project_name }}

defaults:
  run:
    working-directory: backend

jobs:
  verify:
    name: lint + typecheck + test
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        service:
{%- for svc in svcs %}
          - {{ svc }}
{%- endfor %}
{%- if not svcs %}
          # TODO[thread-N3]: no Node service in the registry yet. The matrix is
          # regenerated by /node-architect-scaffold once modules are declared.
          - placeholder-service
{%- endif %}
    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: {{ db }}_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
{%- if has_msg_broker %}
      rabbitmq:
        image: rabbitmq:3.13-alpine
        ports:
          - 5672:5672
        options: >-
          --health-cmd "rabbitmq-diagnostics -q ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
{%- endif %}
    env:
      DATABASE_URL: postgresql://postgres:postgres@localhost:5432/{{ db }}_test?schema=public
{%- if has_msg_broker %}
      AMQP_URL: amqp://guest:guest@localhost:5672
{%- endif %}
    steps:
      - uses: actions/checkout@v4

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: {% raw %}${{ env.PNPM_VERSION }}{% endraw %}

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: {% raw %}${{ env.NODE_VERSION }}{% endraw %}
          cache: pnpm
          cache-dependency-path: backend/pnpm-lock.yaml

      - name: Install
        run: {% raw %}pnpm install --frozen-lockfile --filter "./services/${{ matrix.service }}..."{% endraw %}

      - name: Prisma generate
        working-directory: {% raw %}backend/services/${{ matrix.service }}{% endraw %}
        run: pnpm exec prisma generate

      - name: Lint
        working-directory: {% raw %}backend/services/${{ matrix.service }}{% endraw %}
        run: pnpm run lint

      - name: Typecheck
        working-directory: {% raw %}backend/services/${{ matrix.service }}{% endraw %}
        run: pnpm run typecheck

      - name: Migrate test database
        working-directory: {% raw %}backend/services/${{ matrix.service }}{% endraw %}
        run: pnpm exec prisma migrate deploy

      - name: Unit tests
        working-directory: {% raw %}backend/services/${{ matrix.service }}{% endraw %}
        run: pnpm run test:cov

      - name: E2E tests
        working-directory: {% raw %}backend/services/${{ matrix.service }}{% endraw %}
        run: pnpm run test:e2e

      - name: Upload coverage
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: {% raw %}coverage-${{ matrix.service }}{% endraw %}
          path: {% raw %}backend/services/${{ matrix.service }}/coverage{% endraw %}
          if-no-files-found: ignore
          retention-days: 7

  image:
    name: docker build + push
    runs-on: ubuntu-latest
    needs: verify
    if: github.event_name != 'pull_request'
    strategy:
      fail-fast: false
      matrix:
        service:
{%- for svc in svcs %}
          - {{ svc }}
{%- endfor %}
{%- if not svcs %}
          - placeholder-service
{%- endif %}
    steps:
      - uses: actions/checkout@v4

      - name: Setup Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to the container registry
        uses: docker/login-action@v3
        with:
          registry: {% raw %}${{ env.REGISTRY }}{% endraw %}
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      - name: Image metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: {% raw %}${{ env.REGISTRY }}/${{ github.repository_owner }}/${{ env.IMAGE_PREFIX }}-${{ matrix.service }}{% endraw %}
          tags: |
            type=sha,format=long
            type=ref,event=branch
            {% raw %}type=semver,pattern={{version}}{% endraw %}

      - name: Build and push
        uses: docker/build-push-action@v6
        with:
          context: backend
          file: {% raw %}backend/services/${{ matrix.service }}/Dockerfile{% endraw %}
          build-args: |
            {% raw %}NODE_VERSION=${{ env.NODE_VERSION }}{% endraw %}
            {% raw %}SERVICE=${{ matrix.service }}{% endraw %}
          push: true
          tags: {% raw %}${{ steps.meta.outputs.tags }}{% endraw %}
          labels: {% raw %}${{ steps.meta.outputs.labels }}{% endraw %}
          cache-from: type=gha
          cache-to: type=gha,mode=max
