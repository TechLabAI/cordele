{#-
  github-actions-python.yml.j2 - CI workflow for a Python/FastAPI backend (D-541).

  Jobs: lint (ruff) -> typecheck (mypy) -> test (pytest --cov, Postgres service)
        -> image (docker build + push to GHCR, main only).

  Variables: project_name, python_version, package_name, modules,
             modules_by_backend_language, has_msg_broker
-#}
{%- set _mbl = modules_by_backend_language | default({}, true) -%}
{%- set py_modules = _mbl.get('python') or modules | default([], true) -%}
name: backend-python-ci

on:
  push:
    branches: [main]
    paths:
      - "backend/**"
      - ".github/workflows/backend-python-ci.yml"
  pull_request:
    paths:
      - "backend/**"
      - ".github/workflows/backend-python-ci.yml"

permissions:
  contents: read
  packages: write

env:
  PYTHON_VERSION: "{{ python_version }}"
  UV_CACHE_DIR: /tmp/.uv-cache
  WORKING_DIR: backend

concurrency:
  group: backend-python-ci-{{ '${{ github.ref }}' }}
  cancel-in-progress: true

defaults:
  run:
    working-directory: backend

jobs:
  lint:
    name: ruff
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
        with:
          enable-cache: true
      - name: Install dependencies
        run: uv sync --all-extras
      - name: ruff check
        run: uv run ruff check .
      - name: ruff format --check
        run: uv run ruff format --check .

  typecheck:
    name: mypy
    runs-on: ubuntu-latest
    needs: lint
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
        with:
          enable-cache: true
      - name: Install dependencies
        run: uv sync --all-extras
      - name: mypy
        run: uv run mypy .

  test:
    name: pytest
    runs-on: ubuntu-latest
    needs: typecheck
    services:
      postgres:
        image: postgres:16-alpine
        env:
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: {{ package_name }}_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
{%- if has_msg_broker %}
      rabbitmq:
        image: rabbitmq:3-management-alpine
        ports:
          - 5672:5672
        options: >-
          --health-cmd "rabbitmq-diagnostics -q ping"
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
{%- endif %}
    env:
      DATABASE_URL: postgresql+asyncpg://postgres:postgres@localhost:5432/{{ package_name }}_test
{%- if has_msg_broker %}
      AMQP_URL: amqp://guest:guest@localhost:5672/
{%- endif %}
      JWT_SECRET: ci-only-secret
      LOG_LEVEL: WARNING
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
        with:
          enable-cache: true
      - name: Install dependencies
        run: uv sync --all-extras
      - name: Run migrations
        run: uv run alembic upgrade head
      - name: pytest
        run: uv run pytest --cov --cov-report=xml --cov-report=term
      - name: Upload coverage
        uses: actions/upload-artifact@v4
        with:
          name: coverage-{{ project_name }}-backend
          path: backend/coverage.xml
          if-no-files-found: warn

  image:
    name: docker build and push
    runs-on: ubuntu-latest
    needs: test
    if: github.ref == 'refs/heads/main' && github.event_name == 'push'
    strategy:
      fail-fast: false
      matrix:
        service:
{%- for m in py_modules %}
          - {{ m.backendService if m.backendService is defined and m.backendService else (m.prefix | lower) ~ '-service' }}
{%- endfor %}
{%- if not py_modules %}
          - {{ project_name }}-service
{%- endif %}
    steps:
      - uses: actions/checkout@v4
      - uses: docker/setup-buildx-action@v3
      - name: Log in to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: {{ '${{ github.actor }}' }}
          password: {{ '${{ secrets.GITHUB_TOKEN }}' }}
      - name: Build and push
        uses: docker/build-push-action@v6
        with:
          context: backend/services/{{ '${{ matrix.service }}' }}
          file: backend/services/{{ '${{ matrix.service }}' }}/Dockerfile
          push: true
          tags: |
            ghcr.io/{{ '${{ github.repository }}' }}/{{ '${{ matrix.service }}' }}:latest
            ghcr.io/{{ '${{ github.repository }}' }}/{{ '${{ matrix.service }}' }}:{{ '${{ github.sha }}' }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
