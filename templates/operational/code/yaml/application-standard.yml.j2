{#-
  application-standard.yml.j2 — Standard service profile (with JPA, Eureka, JWT).

  Variables (auto-injected): project_name, package_base, migrations_service
  Variables (passed): meta, pkg_full
-#}
spring:
  application:
    name: {{ meta.service }}
  jpa:
    open-in-view: false
    hibernate:
      ddl-auto: validate
  flyway:
    enabled: false  # Migrations gerenciadas pelo {{ migrations_service }} (V7+)
  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5432/{{ meta.package_suffix }}_dev}
    username: ${DB_USER:{{ meta.package_suffix }}}
    password: ${DB_PASS:{{ meta.package_suffix }}_dev_pass}
    hikari:
      maximum-pool-size: 10
  security:
    oauth2:
      resourceserver:
        jwt:
          issuer-uri: ${KEYCLOAK_ISSUER_URI:http://localhost:8180/realms/{{ project_name }}}

server:
  port: {{ meta.port }}

eureka:
  client:
    service-url:
      defaultZone: ${EUREKA_URI:http://localhost:8761/eureka}
  instance:
    prefer-ip-address: true
    instance-id: ${spring.application.name}:${server.port}

management:
  endpoints:
    web:
      exposure:
        include: health,prometheus
  endpoint:
    health:
      show-details: always
  metrics:
    tags:
      application: ${spring.application.name}

logging:
  pattern:
    console: "%d{HH:mm:ss} %-5level [%X{correlationId}] [%X{tenantId}] [%X{userId}] %logger{36} - %msg%n"
  level:
    {{ pkg_full }}: INFO
