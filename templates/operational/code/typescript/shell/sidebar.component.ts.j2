{#-
  shell/sidebar.component.ts.j2 — Angular sidebar nav component.

  Rendered by: /new-project P5 →
    apps/{project_name}-web/src/app/shell/sidebar.component.ts

  Variables used:
    - project_name, project_display_name
    - frontend_npm_scope
    - modules   list of module dicts (hasUi=true, isInfrastructure=false)

  D-289: SidebarComponent uses Angular signals for active route state.
  Nav items are generated from modules.registry at build time (static list).
-#}
import { ChangeDetectionStrategy, Component, computed, inject } from '@angular/core';
import { Router, RouterLink, RouterLinkActive } from '@angular/router';
import { toSignal } from '@angular/core/rxjs-interop';
import { NavigationEnd, filter, map } from 'rxjs';

interface NavItem {
  path: string;
  label: string;
}

const NAV_ITEMS: NavItem[] = [
{%- for m in modules %}
{%- if not m.isInfrastructure and m.hasUi %}
{%- set _lib_raw = m.frontendLib if m.frontendLib else (m.prefix | lower) %}
{%- set lib = _lib_raw[5:] if _lib_raw[:5] == 'libs/' else _lib_raw %}
  { path: '/{{ lib }}', label: '{{ m.displayName }}' },
{%- endif %}
{%- endfor %}
];

@Component({
  selector: 'app-sidebar',
  standalone: true,
  imports: [RouterLink, RouterLinkActive],
  changeDetection: ChangeDetectionStrategy.OnPush,
  template: `
    <nav class="sidebar">
      <div class="sidebar-brand">{{ project_display_name }}</div>
      <ul class="sidebar-nav">
        @for (item of navItems; track item.path) {
          <li>
            <a
              [routerLink]="item.path"
              routerLinkActive="active"
              class="sidebar-link"
            >{{ '{{' }} item.label {{ '}}' }}</a>
          </li>
        }
      </ul>
    </nav>
  `,
  styles: [`
    .sidebar { display: flex; flex-direction: column; width: 240px; height: 100%; }
    .sidebar-brand { padding: 1rem; font-weight: 600; }
    .sidebar-nav { list-style: none; margin: 0; padding: 0; }
    .sidebar-link { display: block; padding: 0.5rem 1rem; text-decoration: none; }
    .sidebar-link.active { font-weight: 600; }
  `],
})
export class SidebarComponent {
  readonly navItems = NAV_ITEMS;
}
