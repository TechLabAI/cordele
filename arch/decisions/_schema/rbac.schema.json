{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://techlab/arch/decisions/rbac.schema.json",
  "title": "RBAC architecture decision",
  "description": "Formal model of the RBAC aspect: roles, permission bundles, enforcement and data-scope policies. Source of truth from which RBAC markdown templates and (Phase 2) code annotations are derived.",
  "type": "object",
  "required": [
    "_schema_version",
    "version",
    "roles"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": {
      "type": "string",
      "description": "Free-text note for maintainers; not consumed by any generator."
    },
    "_schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema revision of this file (this validator). Bumped when the JSON layout changes incompatibly."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semver of this RBAC decision (independent from techlab-architecture and from architecture/VERSION)."
    },
    "last_changed": {
      "type": "string",
      "format": "date",
      "description": "Date (YYYY-MM-DD) of the last manual edit to this file."
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "string",
          "enum": [
            "pre_authorize",
            "post_authorize",
            "manual"
          ],
          "description": "Default mechanism used to enforce permissions on controller endpoints."
        },
        "fallback": {
          "type": "string",
          "enum": [
            "none",
            "deny",
            "allow"
          ],
          "description": "What happens when no explicit rule matches."
        },
        "audit_required": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "CREATE",
              "READ",
              "UPDATE",
              "DELETE"
            ]
          },
          "description": "HTTP/CRUD actions that must emit audit log entries."
        }
      }
    },
    "data_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_field": {
          "type": "string",
          "description": "Default column used to scope data (e.g. tenant_id)."
        },
        "override_allowed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Role codes allowed to bypass the default scope."
        },
        "types": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "description"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "scope_field": {
                "type": "string"
              },
              "value_kind": {
                "type": "string",
                "enum": [
                  "uuid",
                  "csv-uuid",
                  "string",
                  "none"
                ]
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "code",
          "name",
          "description",
          "category",
          "permission_bundle"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "description": "Stable role code (uppercase, snake). Persisted as papel.codigo."
          },
          "name": {
            "type": "string",
            "description": "Human-readable name used in UI and SQL seeds."
          },
          "description": {
            "type": "string",
            "description": "Short narrative shown in SQL seed comments and in papeis.md."
          },
          "category": {
            "type": "string",
            "enum": [
              "default",
              "optional"
            ],
            "description": "default: applied to all tenants. optional: applied on demand."
          },
          "active": {
            "type": "boolean",
            "default": true,
            "description": "Seeded with ativo=true/false."
          },
          "data_scope_tipo": {
            "type": [
              "string",
              "null"
            ],
            "description": "Default data_scope tipo for users assigned to this role. null = no restriction."
          },
          "permission_bundle": {
            "type": "object",
            "oneOf": [
              {
                "required": [
                  "kind"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "all"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              },
              {
                "required": [
                  "kind",
                  "patterns"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "exclude_patterns"
                  },
                  "patterns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "note": {
                    "type": "string"
                  }
                }
              },
              {
                "required": [
                  "kind",
                  "pattern"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "match_pattern"
                  },
                  "pattern": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              },
              {
                "required": [
                  "kind",
                  "permissions"
                ],
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "list"
                  },
                  "permissions": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "code"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "code": {
                          "type": "string",
                          "description": "Either a fully-qualified permission (cad.cliente.read) or a wildcard (fis.*)."
                        },
                        "scope_note": {
                          "type": "string",
                          "description": "Free-text annotation (e.g. 'data_scope: próprios') rendered next to the permission."
                        }
                      }
                    }
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      },
      "description": "Ships EMPTY in the source of truth (D-103 Gap B); projects fill it via arch/overrides/<aspect>.partial.json (D-074 deep-merge)."
    }
  }
}
