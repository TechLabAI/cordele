{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://techlab/arch/decisions/multi-tenancy.schema.json",
  "title": "Multi-tenancy architecture decision",
  "description": "Cross-project decisions about how multi-tenancy is structured: the available isolation strategies, the supported modes, and the request-context propagation contract. Per-project choices (which mode, which strategy, which schemas) live in project-context.json — see cross_validate_multi_tenancy_against_context. D-063.",
  "type": "object",
  "required": [
    "_schema_version",
    "version",
    "isolation_strategies",
    "modes",
    "context_propagation"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": {
      "type": "string",
      "description": "Free-text note for maintainers; not consumed by any generator."
    },
    "_schema_version": {
      "type": "integer",
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "last_changed": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "isolation_strategies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "description",
          "trade_offs"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Stable identifier referenced by project-context.json multiTenancy.isolationStrategy."
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "hibernate_strategy": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "SCHEMA",
              "DATABASE",
              "DISCRIMINATOR",
              null
            ],
            "description": "Hibernate MultiTenancyStrategy enum value (null = N/A for the 'none' strategy)."
          },
          "connection_provider": {
            "type": [
              "string",
              "null"
            ],
            "description": "Java class name of the Hibernate MultiTenantConnectionProvider, or null when not applicable."
          },
          "trade_offs": {
            "type": "object",
            "required": [
              "positives",
              "negatives"
            ],
            "additionalProperties": false,
            "properties": {
              "positives": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "negatives": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              }
            }
          }
        }
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "description",
          "default_term",
          "default_term_plural",
          "supported_isolation_strategies"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Stable identifier referenced by project-context.json multiTenancy.mode."
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "default_term": {
            "type": "string",
            "description": "Singular form used in identifiers/text (e.g. 'empresa', 'tenant')."
          },
          "default_term_plural": {
            "type": "string"
          },
          "supported_isolation_strategies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "Subset of isolation_strategies[*].id valid for this mode. cross-validate at load time."
          }
        }
      }
    },
    "context_propagation": {
      "type": "object",
      "required": [
        "sync",
        "async"
      ],
      "additionalProperties": false,
      "properties": {
        "sync": {
          "type": "object",
          "required": [
            "jwt_claim_template",
            "http_header_template",
            "holder_class_template",
            "filter_class_template",
            "mdc_key_template",
            "enforcement_rule"
          ],
          "additionalProperties": false,
          "properties": {
            "jwt_claim_template": {
              "type": "string",
              "description": "Jinja template (may contain {{ multi_tenancy_term }}). e.g. '{{ multi_tenancy_term }}_id'."
            },
            "http_header_template": {
              "type": "string"
            },
            "holder_class_template": {
              "type": "string"
            },
            "filter_class_template": {
              "type": "string"
            },
            "mdc_key_template": {
              "type": "string"
            },
            "enforcement_rule": {
              "type": "string",
              "description": "ArchUnit rule identifier (e.g. RULE-07)."
            },
            "enforcement_description": {
              "type": "string"
            }
          }
        },
        "async": {
          "type": "object",
          "required": [
            "jms_header_template",
            "executor_class_template",
            "cleanup"
          ],
          "additionalProperties": false,
          "properties": {
            "jms_header_template": {
              "type": "string"
            },
            "executor_class_template": {
              "type": "string"
            },
            "cleanup": {
              "type": "string",
              "enum": [
                "always_in_finally_block",
                "auto_via_aspect"
              ],
              "description": "How holder state is cleared after async work."
            },
            "cleanup_description": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
