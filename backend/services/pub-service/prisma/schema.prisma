model Publicacao {
  id               String     @id @default(uuid()) @db.Uuid
  projetoId        String     @map("projeto_id") @db.Uuid
  status           String     @default("gerando")
  epubcheckStatus  String     @default("pendente") @map("epubcheck_status")
  sequencia        Int
  artefatoRef      String?    @map("artefato_ref")
  resumoErro       String?    @map("resumo_erro")
  totalErros       Int        @default(0) @map("total_erros")
  totalAvisos      Int        @default(0) @map("total_avisos")
  iniciadaEm       DateTime   @default(now()) @map("iniciada_em") @db.Timestamptz(6)
  concluidaEm      DateTime?  @map("concluida_em") @db.Timestamptz(6)

  @@unique([projetoId, sequencia])
  @@map("publicacao")
}

model ValidationMessage {
  id            String    @id @default(uuid()) @db.Uuid
  publicacaoId  String    @map("publicacao_id") @db.Uuid
  severity      String
  code          String
  message       String
  location      String?
  ordem         Int       @default(0)
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)

  @@map("validation_message")
}
