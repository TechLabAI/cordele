// Prisma schema for pub-service (cordele).
// D-545: Prisma + PostgreSQL is the Node persistence stack.
// Multi-tenancy (multi-empresa): every tenant-scoped table carries a
// `empresaId` discriminator. It is part of every unique constraint and is
// the leading index column, so the tenant filter is always index-covered.
// The application layer must set it from the request context — Prisma has no
// row-level security, so a missing filter is a data leak, not a slow query.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics", "tracing"]
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

/// Reference entity for the PUB bounded context.
/// TODO[thread-N3]: replace with the real aggregates from the module data-model spec.
model Pub {
  id          String   @id @default(uuid()) @db.Uuid
  empresaId String @db.Uuid
  // D-602: optional. This skeleton keeps `code` to demonstrate the tenant-scoped
  // natural key in @@unique below, but the generated domain entity carries no
  // `code`, so a REQUIRED column makes the generated mapper fail to compile
  // (TS2741). Postgres allows several NULLs in a unique index, so the pattern
  // still holds. The real aggregates replace this model anyway.
  code        String?  @db.VarChar(64)
  name        String   @db.VarChar(255)
  description String?  @db.Text
  // D-602: the domain entity and the mapper generated beside this file carry a
  // lifecycle `status` (PubStatus: ACTIVE | INACTIVE | ARCHIVED). Without
  // the column the mapper does not compile — `active` is the soft-delete flag,
  // not the lifecycle state, so it cannot stand in for it.
  status      String   @default("ACTIVE") @db.VarChar(32)
  active      Boolean  @default(true)
  version     Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  createdBy   String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  updatedBy   String?  @db.VarChar(255)

  @@unique([empresaId, code])
  @@index([empresaId, active])
  @@map("pub_pub")
}

