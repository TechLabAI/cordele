# pub-service — local environment (D-544 / D-545).
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=*

# Prisma (D-545)
DATABASE_URL=postgresql://cordele:cordele@localhost:5432/cordele_dev?schema=public

# Auth
JWT_ISSUER_URI=http://localhost:8180/realms/cordele
JWT_AUDIENCE=pub-service

# epubcheck (PUB-010) — download epubcheck from https://github.com/w3c/epubcheck/releases
# Requires JRE 11+ on PATH. Health endpoint reports DOWN when absent.
EPUBCHECK_JAR_PATH=/opt/epubcheck/epubcheck.jar

# File storage (PUB-011) — disk storage for POC; replace adapter for S3 in production
PUB_STORAGE_ROOT=/var/pub-service/storage
PUB_DOWNLOAD_URL_TTL_SECONDS=900
PUB_SIGN_SECRET=change-me-in-production

# Stub adapters (PUB-012) — use stubs for IMP/COMP/PROJ in dev/test
# Set to true in CI or when sibling services are unavailable
PUB_USE_STUBS=true
# Set to true to simulate missing manuscript (pre-flight 409 path)
PUB_MANUSCRIPT_STUB_NULL=false
# Set to true to simulate missing metadados (pre-flight 422 path)
PUB_METADADOS_STUB_NULL=false

# Cross-service HTTP clients (INT-PUB-001, INT-PUB-003)
# Active when PUB_USE_STUBS=false. Defaults match the local docker-compose ports.
IMP_SERVICE_URL=http://localhost:3001
PROJ_SERVICE_BASE_URL=http://localhost:3002
