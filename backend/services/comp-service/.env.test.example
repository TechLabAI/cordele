# comp-service — test environment (P5 COMP-013)
# Pitfall: bdd-scaffold:application-test-yml:missing-jwk-set-uri
# OIDC discovery is disabled in tests; JWT_SECRET is used instead.
NODE_ENV=test
PORT=3001
LOG_LEVEL=error

# Prisma (test DB — override per test runner)
DATABASE_URL=postgresql://cordele:cordele@localhost:5432/cordele_test?schema=public

# Auth — stub values for unit/integration tests (no real OIDC)
JWT_ISSUER_URI=http://localhost:9999/realms/cordele-test
JWT_AUDIENCE=comp-service
