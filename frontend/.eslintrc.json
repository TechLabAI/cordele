{
  "root": true,
  "ignorePatterns": ["**/*", "!libs/**", "!apps/**"],
  "plugins": ["@nx"],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {
        "@nx/enforce-module-boundaries": [
          "error",
          {
            "enforceBuildableLibDependency": true,
            "allow": [],
            "depConstraints": [
              { "sourceTag": "*", "onlyDependOnLibsWithTags": ["*"] },

              { "sourceTag": "scope:imp", "onlyDependOnLibsWithTags": ["scope:imp", "scope:shared"] },
              { "sourceTag": "scope:comp", "onlyDependOnLibsWithTags": ["scope:comp", "scope:shared"] },
              { "sourceTag": "scope:pub", "onlyDependOnLibsWithTags": ["scope:pub", "scope:shared"] },
              { "sourceTag": "scope:proj", "onlyDependOnLibsWithTags": ["scope:proj", "scope:shared"] },

              { "sourceTag": "type:app", "onlyDependOnLibsWithTags": ["type:feature", "type:data-access", "type:domain", "type:ui", "type:app"] },
              { "sourceTag": "type:feature", "onlyDependOnLibsWithTags": ["type:data-access", "type:domain", "type:ui"] },
              { "sourceTag": "type:data-access", "onlyDependOnLibsWithTags": ["type:domain"] },
              { "sourceTag": "type:domain", "onlyDependOnLibsWithTags": ["type:domain"] },
              { "sourceTag": "type:ui", "onlyDependOnLibsWithTags": ["type:domain", "type:ui"] },
              { "sourceTag": "type:e2e", "onlyDependOnLibsWithTags": ["*"] }
            ]
          }
        ]
      }
    },
    {
      "files": ["*.ts", "*.tsx"],
      "extends": ["plugin:@nx/typescript"],
      "rules": {
        "@typescript-eslint/no-unused-vars": [
          "error",
          { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
        ],
        "@typescript-eslint/no-explicit-any": "warn"
      }
    },
    {
      "files": ["*.js", "*.jsx"],
      "extends": ["plugin:@nx/javascript"],
      "rules": {}
    },
    {
      "files": ["*.spec.ts", "*.spec.tsx", "*.e2e-spec.ts"],
      "rules": { "@typescript-eslint/no-explicit-any": "off" }
    }
  ]
}
