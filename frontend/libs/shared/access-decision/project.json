{
  "name": "shared-access-decision",
  "projectType": "library",
  "sourceRoot": "libs/shared/access-decision/src",
  "tags": [
    "type:domain",
    "scope:shared"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/shared/access-decision/ng-package.json",
        "tsConfig": "libs/shared/access-decision/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/shared/access-decision/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
