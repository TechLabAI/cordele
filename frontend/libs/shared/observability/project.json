{
  "name": "shared-observability",
  "projectType": "library",
  "sourceRoot": "libs/shared/observability/src",
  "tags": [
    "type:data-access",
    "scope:shared"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "options": {
        "project": "libs/shared/observability/ng-package.json",
        "tsConfig": "libs/shared/observability/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/shared/observability/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
