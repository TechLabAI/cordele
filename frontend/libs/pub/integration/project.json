{
  "name": "pub-integration",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/pub/integration/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [
    "scope:pub",
    "type:feature"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "options": {
        "project": "libs/pub/integration/ng-lib.json",
        "tsConfig": "libs/pub/integration/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/pub/integration/tsconfig.lib.prod.json"
        },
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/angular:unit-test",
      "options": {
        "watch": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
