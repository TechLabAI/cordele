{
  "name": "comp-data-access",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/comp/data-access/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["scope:comp", "type:data-access"],
  "targets": {
    "build": {
      "executor": "@nx/angular:ng-packagr-lite",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/comp/data-access/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/comp/data-access/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/comp/data-access/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "coverage/libs/comp/data-access"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
