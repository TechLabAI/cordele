{
  "name": "cordele-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/cordele-web/src",
  "tags": ["type:app", "scope:web"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/cordele-web",
        "index": "apps/cordele-web/src/index.html",
        "browser": "apps/cordele-web/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/cordele-web/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/cordele-web/src/assets",
            "output": "assets"
          }
        ],
        "styles": ["apps/cordele-web/src/styles.css"],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            { "type": "initial", "maximumWarning": "500kb", "maximumError": "1mb" }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "proxyConfig": "apps/cordele-web/proxy.conf.json"
      },
      "configurations": {
        "production": { "buildTarget": "cordele-web:build:production" },
        "development": { "buildTarget": "cordele-web:build:development" }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": { "lintFilePatterns": ["apps/cordele-web/**/*.ts"] }
    }
  }
}
